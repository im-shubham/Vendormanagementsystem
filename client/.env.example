# ---------------------------------------------------------------
# Firebase web app configuration (Firebase Console → Project settings
# → General → Your apps → Web app → SDK setup and configuration).
# Copy to client/.env.local. These identify the project; they are not
# secrets. NEVER put service-account / Admin SDK credentials here.
# ---------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Must match the Cloud Functions region (functions/.env APP_REGION)
VITE_FIREBASE_FUNCTIONS_REGION=asia-south1

# Local development against the Firebase Emulator Suite
VITE_USE_FIREBASE_EMULATORS=false

# Contact address shown to vendors (account rejected / help page)
VITE_SUPPORT_EMAIL=vendor.support@rcpl.example
