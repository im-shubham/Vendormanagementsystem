rules_version = '2';

// =====================================================================
// RCPL Vendor POD Management — Firestore Security Rules
//
// Roles (custom claim `role`, set ONLY by Cloud Functions / admin script):
//   ADMIN     everything
//   CATEGORY  vendors + PODs of the categories on their profile
//   BILLING   PODs that have been forwarded to billing
//   VENDOR    own vendor record; own PODs only while the account is ACTIVE
// Staff profiles must be active; category assignments are read from the
// profile on every request (never from the client).
// Clients never write business data — all writes go through Cloud Functions.
// The only client write is marking one's own notification as read.
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function role() { return request.auth.token.role; }
    function me() { return get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data; }

    function isStaff(r) { return signedIn() && role() == r && me().get('active', true) == true; }
    function isAdmin() { return isStaff('ADMIN'); }
    function isCategory() { return isStaff('CATEGORY'); }
    function isBilling() { return isStaff('BILLING'); }
    function myCategories() { return me().get('categories', []); }

    function isVendor() { return signedIn() && role() == 'VENDOR' && request.auth.token.vendorId is string; }
    function myVendorId() { return request.auth.token.vendorId; }
    function vendorIsActive() {
      return isVendor() && get(/databases/$(database)/documents/vendors/$(myVendorId())).data.accountStatus == 'ACTIVE';
    }

    // POD-related documents carry vendorId + category (+ billingVisible on submissions).
    function canReadSubmission(d) {
      return isAdmin()
        || (isCategory() && d.category in myCategories())
        || (isBilling() && d.billingVisible == true)
        || (vendorIsActive() && d.vendorId == myVendorId());
    }
    // Documents / history: billing visibility is taken from the parent submission.
    function canReadPodChild(d) {
      return isAdmin()
        || (isCategory() && d.category in myCategories())
        || (vendorIsActive() && d.vendorId == myVendorId())
        || (isBilling() && get(/databases/$(database)/documents/podSubmissions/$(d.submissionId)).data.billingVisible == true);
    }

    match /vendors/{vendorId} {
      allow read: if isAdmin()
        || (isVendor() && vendorId == myVendorId())            // own record, any status (status screens)
        || (isCategory() && resource.data.get('categories', []).hasAny(myCategories()));
      allow write: if false;
    }

    match /userProfiles/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow write: if false;
    }

    match /vendorRegistrationRequests/{requestId} {
      allow read: if isAdmin() || (isVendor() && resource.data.vendorId == myVendorId());
      allow write: if false;
    }

    match /podSubmissions/{submissionId} {
      allow read: if canReadSubmission(resource.data);
      allow write: if false;
    }

    match /podDocuments/{documentId} {
      allow read: if canReadPodChild(resource.data);
      allow write: if false;
    }

    match /podStatusHistory/{historyId} {
      allow read: if canReadPodChild(resource.data);
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
        && request.resource.data.isRead == true;
      allow create, delete: if false;
    }

    // Internal: counters, uniqueness keys, etc. Server only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
