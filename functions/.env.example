# Cloud Functions configuration (copy to functions/.env)
# Region — must match VITE_FIREBASE_FUNCTIONS_REGION in client/.env.local
APP_REGION=asia-south1
# Public URL of the portal, used for links in emails
APP_URL=https://rcpl-pod-prod.web.app
# Emails are queued in the `mail` collection and sent by the
# "Trigger Email from Firestore" extension. Set to false to stop queuing.
EMAIL_ENABLED=true
