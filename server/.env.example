# ---------------------------------------------------------------
# RCPL Vendor POD Management — API configuration
# Copy to server/.env and fill in. NEVER commit the real .env file.
# ---------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
# Public URL of the frontend (used in password-reset links)
APP_URL=http://localhost:5173

# PostgreSQL connection string.
# Supabase: Project Settings > Database > Connection string (URI). Use the
# direct connection or the *session* pooler (port 5432).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rcpl_pod
# Set to true for Supabase / any hosted DB that requires TLS
DATABASE_SSL=false

# ---- Authentication --------------------------------------------
# supabase = Supabase Auth (recommended for deployment)
# local    = built-in bcrypt + JWT provider (local development / demos without Supabase)
AUTH_PROVIDER=local
# Required when AUTH_PROVIDER=local (long random string)
LOCAL_JWT_SECRET=change-me-to-a-long-random-string

# ---- Storage ---------------------------------------------------
# supabase = Supabase Storage (private bucket)
# local    = server disk (./uploads) — development only
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./uploads
SUPABASE_STORAGE_BUCKET=pod-documents
MAX_UPLOAD_MB=10

# ---- Supabase (required if AUTH_PROVIDER or STORAGE_PROVIDER = supabase)
SUPABASE_URL=https://your-project-ref.supabase.co
# Server-side only. Never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
